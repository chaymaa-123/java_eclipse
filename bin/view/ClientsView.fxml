<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ClientsController">
   
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style=" -fx-padding: 15;">
         <children>
            <Label text="Fichier Clients" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="15.0" style="-fx-padding: 20;">
         <children>
            
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 5;">
               <children>
                  <Label text="Info Client:" style="-fx-font-weight: bold;"/>
                  <TextField fx:id="nomField" promptText="Nom Complet"/>
                  <TextField fx:id="telField" promptText="Téléphone"/>
                  <TextField fx:id="emailField" promptText="Email" prefWidth="200"/>
                  
                  <Button text="Enregistrer" onAction="#ajouterClient" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"/>
               </children>
            </HBox>

            <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="nomColumn" text="Nom" prefWidth="200"  style="-fx-alignment: CENTER;"/>
                  <TableColumn fx:id="telColumn" text="Téléphone" prefWidth="150"  style="-fx-alignment: CENTER;"/>
                  <TableColumn fx:id="emailColumn" text="Email" prefWidth="250"  style="-fx-alignment: CENTER;"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
               <Button text="Modifier la sélection" onAction="#modifierClient" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"/>
               <Button text="Supprimer la sélection" onAction="#supprimerClient" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>

         </children>
      </VBox>
   </center>
</BorderPane>