<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CommandesController">
   
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style=" -fx-padding: 15;">
         <children>
            <Label text="Suivi Cuisine &amp; Caisse" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Button onAction="#refreshTable" style="-fx-background-color: #ecf0f1; -fx-text-fill: #2c3e50; -fx-cursor: hand;" text="Actualiser la liste ⟳">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </top>

   <center>
      <SplitPane dividerPositions="0.65" prefHeight="160.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
            <VBox spacing="10.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <TableView fx:id="commandesTable" VBox.vgrow="ALWAYS" style="-fx-selection-bar: #dfe6e9; -fx-selection-bar-non-focused: #dfe6e9;">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="50.0" style="-fx-alignment: CENTER;" text="#" />
                      <TableColumn fx:id="colDate" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Heure" />
                        <TableColumn fx:id="colTable" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Table" />
                        <TableColumn fx:id="colClient" prefWidth="120.0" text="Client" />
                        <TableColumn fx:id="colTotal" prefWidth="80.0" style="-fx-alignment: CENTER-RIGHT;" text="Total" />
                        <TableColumn fx:id="colStatut" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Statut" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: #f8f9fa;">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label text="Détails de la commande" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  
                  <ListView fx:id="detailsListView" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 3;" />
                  
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 5 0 5 0;">
                     <children>
                        <Label text="Total à payer :">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Label fx:id="totalDetailLabel" text="0.00 €" textFill="#27ae60">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  
                  <Label text="Actions Cuisine :" textFill="#7f8c8d" style="-fx-padding: 10 0 5 0; -fx-font-size: 11px; -fx-font-weight: bold;" />
                  
                  <Button fx:id="btnServie" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#marquerCommeServie" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="Marquer comme SERVIE">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                     <padding>
                        <Insets bottom="8.0" top="8.0" />
                     </padding>
                  </Button>
                  
                  <Label text="Actions Caisse :" textFill="#7f8c8d" style="-fx-padding: 10 0 5 0; -fx-font-size: 11px; -fx-font-weight: bold;" />

                  <Button fx:id="btnPayee" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#marquerCommePayee" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="ENCAISSER (PAYÉE)">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                     <padding>
                        <Insets bottom="8.0" top="8.0" />
                     </padding>
                  </Button>
               </children>
            </VBox>
        </items>
      </SplitPane>
   </center>
</BorderPane>