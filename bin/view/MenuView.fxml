<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">
   
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style=" -fx-padding: 15;">
         <children>
            <Label text="Gestion du Menu" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <left>
      <VBox prefWidth="280.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #bdc3c7; -fx-border-width: 0 1 0 0;">
         <children>
            <Label text="Nouveau Plat">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            
            <VBox spacing="5.0">
               <Label text="Nom du plat :" />
               <TextField fx:id="nomField" promptText="Ex: Pizza Margherita" />
            </VBox>
            
            <VBox spacing="5.0">
               <Label text="Catégorie :" />
               <TextField fx:id="categorieField" promptText="Ex: Plat Principal" />
            </VBox>
            
            <VBox spacing="5.0">
               <Label text="Prix (€) :" />
               <TextField fx:id="prixField" promptText="Ex: 12.50" />
            </VBox>
            
            <CheckBox fx:id="dispoCheckbox" selected="true" text="Disponible immédiatement" />
            
            <Button maxWidth="1.7976931348623157E308" onAction="#ajouterPlat" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" text="Ajouter au Menu">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="10.0" style="-fx-padding: 20;">
         <children>
            <Label text="Liste des Plats">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            
            <TableView fx:id="menuTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nomColumn" prefWidth="200.0" text="Nom" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="categorieColumn" prefWidth="120.0" text="Catégorie" />
                <TableColumn fx:id="prixColumn" prefWidth="80.0" text="Prix" />
                <TableColumn fx:id="dispoColumn" prefWidth="80.0" text="Dispo" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button onAction="#modifierPlat" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;" text="Modifier la sélection" />
                  <Button onAction="#supprimerPlat" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Supprimer la sélection" />
                              <Button mnemonicParsing="false" onAction="#exporterAction" prefHeight="35.0" prefWidth="100.0" style=";  -fx-cursor: hand;" text="Exporter" />
            <Button mnemonicParsing="false" onAction="#importerAction" prefHeight="35.0" prefWidth="100.0" style=" -fx-cursor: hand;" text="Importer" /> 
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   
</BorderPane>