<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.OrderController">
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <top>
      <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Prise de Commande">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

     
            <HBox fx:id="staffControlsBox" alignment="CENTER" managed="false" spacing="10.0" visible="false" style="-fx-background-color: #fff3cd; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #ffeeba; -fx-border-radius: 5;">
               <children>
                  <Label text="📍 Mode Serveur activé - Sélectionner la Table :" style="-fx-font-weight: bold;"/>
                  <ComboBox fx:id="tableComboBox" prefWidth="150.0" promptText="-- Choisir Table --" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" />
         </padding>
      </VBox>
   </top>

   <left>
      <VBox spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 5; -fx-border-color: #dee2e6; -fx-border-radius: 5;" BorderPane.alignment="CENTER" prefWidth="280.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Ajouter un article">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>

            <VBox spacing="5.0">
               <children>
                  <Label text="Nom du Client :" />
                  <TextField fx:id="clientNameField" promptText="Ex: Jean Dupont" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Plat / Boisson :" />
                  <ComboBox fx:id="platComboBox" maxWidth="1.7976931348623157E308" promptText="Choisir dans le menu..." />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Quantité :" />
                  <Spinner fx:id="quantiteSpinner" editable="true" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ajouterPlat" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Ajouter au panier">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" />
         </padding>
         <children>
            <Label text="Panier en cours">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>

            <ListView fx:id="ligneCommandeListView" VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-background-color: #e9ecef; -fx-background-radius: 5;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="TOTAL À PAYER :">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalLabel" text="0.00 €" textFill="#27ae60">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#annulerCommande" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Tout effacer" />
                  <Button mnemonicParsing="false" onAction="#validerCommande" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" text="Valider la Commande">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>