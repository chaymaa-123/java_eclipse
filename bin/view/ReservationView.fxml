<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReservationController">
   
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style=" -fx-padding: 15;">
         <children>
            <Label text="Gestion des Réservations" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="15.0" style="-fx-padding: 20;">
         <children>
            
            <VBox style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Label text="Nouvelle Réservation" textFill="#7f8c8d">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>
                  
                  <HBox alignment="BOTTOM_LEFT" spacing="15.0">
                     <children>
                        <VBox spacing="5">
                           <Label text="Client :" textFill="#2c3e50" style="-fx-font-weight: bold;"/>
                           <ComboBox fx:id="clientComboBox" promptText="Choisir Client" prefWidth="160" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 3;"/>
                        </VBox>

                        <VBox spacing="5">
                           <Label text="Table (Libre) :" textFill="#2c3e50" style="-fx-font-weight: bold;"/>
                           <ComboBox fx:id="tableComboBox" promptText="Choisir Table" prefWidth="140" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 3;"/>
                        </VBox>

                        <VBox spacing="5">
                           <Label text="Date :" textFill="#2c3e50" style="-fx-font-weight: bold;"/>
                           <DatePicker fx:id="datePicker" prefWidth="130" style="-fx-background-color: white;"/>
                        </VBox>

                        <VBox spacing="5">
                           <Label text="Heure :" textFill="#2c3e50" style="-fx-font-weight: bold;"/>
                           <TextField fx:id="heureField" promptText="HH:mm" prefWidth="80" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 3;"/>
                        </VBox>

                        <VBox spacing="5">
                           <Label text="Pers :" textFill="#2c3e50" style="-fx-font-weight: bold;"/>
                           <TextField fx:id="nbPersonnesField" promptText="Nb" prefWidth="60" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 3;"/>
                        </VBox>
                        
                        <Button text="Ajouter" onAction="#ajouterReservation" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                           <padding>
                              <Insets bottom="7.0" left="15.0" right="15.0" top="7.0" />
                           </padding>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <TableView fx:id="reservationTable" VBox.vgrow="ALWAYS" style="-fx-border-color: #bdc3c7; -fx-background-radius: 3;">
               <columns>
                  <TableColumn fx:id="idColumn" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                  <TableColumn fx:id="dateColumn" text="Date &amp; Heure" prefWidth="160" style="-fx-alignment: CENTER;"/>
                  <TableColumn fx:id="clientColumn" text="Client" prefWidth="180" style="-fx-alignment: CENTER;"/>
                  <TableColumn fx:id="tableColumn" text="Table" prefWidth="100" style="-fx-alignment: CENTER;"/>
                  <TableColumn fx:id="nbPersColumn" text="Nb Pers." prefWidth="80" style="-fx-alignment: CENTER;"/>
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <HBox spacing="15" alignment="CENTER_RIGHT">
               <Button text="Modifier la sélection" onAction="#modifierReservation" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;">
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
                  <padding>
                     <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                  </padding>
               </Button>
               
               <Button text="Supprimer la sélection" onAction="#supprimerReservation" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;">
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
                  <padding>
                     <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                  </padding>
               </Button>
            </HBox>

         </children>
      </VBox>
   </center>
</BorderPane>